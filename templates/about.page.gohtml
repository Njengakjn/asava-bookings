{{template "base" .}}
{{define "content"}}
<div class="container">
    <div class="row">
        <div class="col">
            <h1>About Page</h1>
            <p>
                {{if ne (index .SMap "remote_ip") ""}}
                    Your remote IP address is {{index .SMap "remote_ip"}}
                {{else}}
                    i don't know you ip address.
                {{end}}
            </p>
        </div>
    </div>
</div>
{{end}}
